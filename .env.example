# Path to the fine-tuned checkpoint. If the file is missing it is fetched from
# the public Kaggle dataset below on first start (no credentials needed).
MODEL_WEIGHTS=artifacts/best.pt
WEIGHTS_KAGGLE_DATASET=kanagavelak/ppe-rtdetr-weights

# Detection defaults
CONF_THRESHOLD=0.25
IMGSZ=640

# Guardrail: detections weaker than this cannot support an assertion
LOW_CONFIDENCE_FLOOR=0.45

# Optional. Without it the reasoning layer answers from templates.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=12582912
